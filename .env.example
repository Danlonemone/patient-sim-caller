# --- LiveKit Cloud (project settings -> keys) ---
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- Twilio Elastic SIP trunk (used once by `python -m caller.setup_trunk`) ---
# Termination SIP URI from the Twilio trunk, without the "sip:" prefix
TWILIO_TERMINATION_URI=your-trunk.pstn.twilio.com
# Credential list username/password attached to the trunk's termination settings
TWILIO_SIP_USERNAME=
TWILIO_SIP_PASSWORD=
# The Twilio number calls are placed from (E.164); this is the caller ID the target agent sees.
CALLER_ID_NUMBER=+1XXXXXXXXXX

# --- Who to call ---
# The receptionist line to test (E.164). It must also appear in ALLOWED_TARGETS (comma-separated),
# or the bot refuses to dial. Only call agents you own or are authorised to test.
TARGET_NUMBER=+1XXXXXXXXXX
ALLOWED_TARGETS=+1XXXXXXXXXX

# --- Written by setup_trunk.py: the LiveKit outbound trunk ID (ST_...) ---
LIVEKIT_SIP_TRUNK_ID=

# --- Speech + LLM providers ---
DEEPGRAM_API_KEY=
ANTHROPIC_API_KEY=
# Only needed with TTS_PROVIDER=cartesia
CARTESIA_API_KEY=

# --- Optional overrides ---
# TTS_PROVIDER=deepgram   # or: cartesia
# PATIENT_LLM_MODEL=claude-haiku-5-5
# ANALYSIS_MODEL=claude-opus-5-5
